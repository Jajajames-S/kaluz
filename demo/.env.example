# Copia este archivo a demo/.env (esta en .gitignore) y completa los valores de Supabase.
# Supabase > Project Settings > Database > Connection string > "Session pooler" (puerto 5432, compatible IPv4)
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.TU_PROJECT_REF
DB_PASSWORD=TU_PASSWORD
CORS_ORIGINS=http://localhost:4200
